# Node / TS (P0.3+)
node_modules/
packages/*/node_modules/
ui/node_modules/
dist/
*.tsbuildinfo

# OS junk
.DS_Store
Thumbs.db

# Editor / local
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# Local runtime state (never commit user data)
*.db
*.db-shm
*.db-wal

# P8.8 auto-updater signing keys (private key + password must never be committed)
.tauri/

# Uploaded screenshots (not project assets)
*.png
# ...except the Tauri app icons (needed by `tauri build`/bundle on every
# fresh checkout — README also hotlinks the 128x128 logo) and the two root
# screenshots embedded in README.
!src-tauri/icons/*.png
!5a1c3357-0cd1-492f-ac9f-efd313391587.png
!8cfdc45d-f91f-4857-8ca5-9777c8ae4822.png

# P50.3 sidecar resource: the bun-compiled coordinator binary (97MB, built
# via `pnpm --filter @agentcowork/coordinator build` + copy — never committed)
src-tauri/bin/

# Benchmark test artifacts
.agentcowork_bench/
packages/coordinator/.agentcowork_bench/

# Code intelligence artifacts (agent-agnostic code analysis)
.code-intelligence/

# Optional local semantic/static-analysis caches
.scip/
.codeql/

# Python state (codebase-intelligence skill: venvs and bytecode caches)
.venv/
venv/
__pycache__/
*.pyc

# Local scratch transcripts (working notes, not repository content)
multiagent.txt

# Deepwork progress state (local planning only)
.slim/deepwork/

# Local overhaul archive: superseded docs moved out of the tracked set
# (root-anchored; ARCH/archive/ is tracked and unaffected)
/ARCHIVE/
