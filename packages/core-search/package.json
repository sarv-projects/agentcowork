{
  "name": "@agentcowork/core-search",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "default": "./dist/mobile.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/data',{recursive:true});require('fs').copyFileSync('src/data/searx-pool.json','dist/data/searx-pool.json')\"",
    "type-check": "tsc --noEmit",
    "lint": "pnpm --workspace-root exec eslint packages/core-search",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@agentcowork/core-domain": "workspace:*",
    "cheerio": "^1.2.0"
  }
}
