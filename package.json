{
  "name": "agentcowork-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "AgentCowork desktop workspace (Tauri shell + TS coordinator sidecar)",
  "scripts": {
    "coordinator:dev": "pnpm --filter @agentcowork/coordinator dev",
    "coordinator:test": "pnpm --filter @agentcowork/coordinator test",
    "coordinator:typecheck": "pnpm --filter @agentcowork/coordinator type-check",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:verify-clean-boot": "node scripts/clean-profile-boot-check.mjs",
    "ipc:parity": "node scripts/ipc-parity.mjs --md",
    "check:arch": "node scripts/check-arch-invariants.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:release-matrix": "node scripts/check-release-matrix.mjs",
    "check:app-metadata": "node scripts/check-app-metadata.mjs",
    "check:native-deps": "node scripts/check-native-deps.mjs",
    "check:size-budget": "node scripts/check-size-budget.mjs",
    "check:store-schemas": "node scripts/check-store-schemas.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "check:updater-keys": "node scripts/check-updater-keys.mjs",
    "check:update-pipeline": "node scripts/check-update-pipeline.mjs",
    "check:diagnostics-surface": "node scripts/check-diagnostics-surface.mjs",
    "check:release-surface": "node scripts/gen-release-surface.mjs --check",
    "check:prompt-steering": "node scripts/check-prompt-steering.mjs",
    "check:doc-refs": "node scripts/check-doc-refs.mjs",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "gen:release-surface": "node scripts/gen-release-surface.mjs",
    "release:qualify": "node scripts/release-qualify.mjs",
    "release:qualify:execute": "node scripts/release-qualify.mjs --execute",
    "gen:sbom": "node scripts/gen-sbom.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
