{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentCowork",
  "version": "0.1.0",
  "identifier": "com.everyaios.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentCowork",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "resources": ["bin/coordinator*"],
    "targets": ["nsis", "msi", "dmg", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "publisher": "AgentCowork",
    "copyright": "Copyright © 2026 AgentCowork contributors",
    "homepage": "https://github.com/sarv-projects/AgentCowork",
    "license": "MIT OR Apache-2.0",
    "shortDescription": "AgentCowork — agentic desktop OS shell",
    "longDescription": "A local-first, BYOK, open-source desktop workspace where your chat, browser, files, documents, code, automations, agents, and connected accounts live in one safe continuity.",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "5420d70f-175e-5ffa-b1d1-bd2ab2d3b8c9"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNTg2MjM4OUE2QjM5NUEKUldSYU9XdWFPR0pZVWFyU0wyM1VQaE9FSW5GdmRIRmx5WllSTW1XcG9hM2tLREEzVTQwRmdRWWgK",
      "endpoints": [
        "https://releases.everyaios.dev/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/sarv-projects/AgentCowork/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
